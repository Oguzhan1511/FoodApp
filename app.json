{
  "expo": {
    "name": "foodapp",
    "slug": "foodapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "foodapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.oguzhanozdemir3.foodapp",
      "infoPlist": {
        "NSMotionUsageDescription": "Bu uygulama günlük kalori yakımınızı hesaplayabilmek için adım sayınıza erişim gerektirir."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.oguzhanozdemir3.foodapp",
      "googleServicesFile": "./google-services.json",
      "permissions": ["ACTIVITY_RECOGNITION"]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-image-picker",
      [
        "expo-sensors",
        {
          "motionPermission": "Bu uygulama günlük kalori yakımınızı hesaplayabilmek için adım sayınıza erişim gerektirir."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e4616acb-05b9-4b9f-988c-38936352ea86"
      }
    },
    "owner": "oguzhanozdemir3"
  }
}